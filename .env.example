# Copia este fichero a .env (no se sube a git) y rellena lo que uses.

# Aplicación bajo prueba (obligatoria)
BASE_URL=

# IA del reporte (report:ai, design:ai). Con AI_API_KEY manda el proveedor compatible con OpenAI de
# AI_BASE_URL (por ejemplo OpenRouter); si no, Gemini con GEMINI_API_KEY.
GEMINI_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Tickets de Jira para los bug_producto (jira:tickets). Sin ellas, modo simulado: no envía nada.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug

# Healer (heal:ai): GitLab abre una MR con GITLAB_TOKEN (scope api); GitHub, una PR con gh.
GITLAB_TOKEN=
