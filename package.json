{
  "name": "playwright-saucedemo",
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:all": "playwright test",
    "test:demo:green": "playwright test --grep-invert @demo-fail",
    "test:demo:fail": "playwright test --grep @demo-fail",
    "test:scenario:cascade": "cross-env DEMO_SCENARIO=cascade playwright test --grep-invert @demo-fail",
    "test:scenario:bug": "cross-env DEMO_SCENARIO=bug playwright test --grep-invert @demo-fail",
    "test:scenario:flaky": "cross-env DEMO_SCENARIO=flaky playwright test --grep-invert @demo-fail --retries=1",
    "test:scenario:env": "cross-env DEMO_SCENARIO=env playwright test --grep-invert @demo-fail",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:report": "playwright show-report",
    "test:unit": "node --test scripts/triage.test.mjs scripts/merge-results.test.mjs scripts/dashboard.test.mjs",
    "report:ai": "node scripts/report-ai.mjs",
    "test:ai": "npm run test && npm run report:ai",
    "eval:ai": "node scripts/eval-ai.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "dashboard:demo": "node scripts/dashboard.mjs --demo",
    "ruta-qa:check": "node scripts/ruta-qa-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.19.39",
    "cross-env": "^10.1.0",
    "typescript": "^5.0.0"
  }
}
